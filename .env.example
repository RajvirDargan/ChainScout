# Copy to .env and paste your keys. .env is gitignored and read only by this agent.

# Discovery — free instant signup at https://developer.adzuna.com
# ~1,000 calls/month, 50 results per call. Replaces Firecrawl search.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Extraction fallback — free key at https://aistudio.google.com/apikey
# 1,000 requests/day on flash-lite. Only used for pages without JSON-LD.
GEMINI_API_KEY=your-gemini-key

# Optional. DISABLED by default in config.yaml (sources.firecrawl.enabled: false)
# because it cost 324 credits in one run against a 1,000/month tier.
FIRECRAWL_API_KEY=fc-your-key-here

# Sending — replaces Claude's Gmail connector.
# Generate a 16-character app password at myaccount.google.com/apppasswords (2FA required);
# a normal account password will NOT work for SMTP.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
