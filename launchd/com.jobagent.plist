<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.jobagent</string>

  <!-- launchd starts with no shell and no PATH, so every path here is absolute. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/anaconda3/bin/python3</string>
    <string>/Users/YOUR_USERNAME/path/to/job_agent/src/run.py</string>
    <string>daily</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/path/to/job_agent</string>

  <!--
    Three triggers, one idempotent job. `daily` exits immediately if today's digest
    already went out, or if it is before the configured earliest time, so firing often
    is harmless and guarantees delivery on the first opportunity.

      StartCalendarInterval  the normal 07:30 slot
      RunAtLoad              login / reboot - covers the Mac having been powered OFF,
                             which is the case launchd's own catch-up handles worst
      StartInterval          hourly net - covers waking from sleep at any hour
  -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/path/to/job_agent/logs/launchd-out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/path/to/job_agent/logs/launchd-err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOUR_USERNAME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/opt/anaconda3/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/YOUR_USERNAME</string>
  </dict>

  <!-- Background priority, and don't let a run block the Mac going back to sleep. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
